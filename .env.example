# ============================================================
# DigiRest v2 — Variables de Entorno (Dokploy / VPS)
# ============================================================

# Entorno y Puerto
NODE_ENV=production
PORT=3000

# Seguridad JWT (generar con: openssl rand -hex 32)
JWT_SECRET=REEMPLAZAR_CON_CADENA_HEX_ALEATORIA_DE_64_CARACTERES

# Integración SaaS Manager Central (panel.digidan.co)
# URL del panel central y API Key / Token del inquilino (Tenant Key)
SAAS_MANAGER_URL=https://panel.digidan.co
SAAS_TENANT_KEY=tu_token_secreto_generado_en_panel

# CORS (lista separada por comas con el subdominio real del restaurante; si se omite acepta same-origin)
ALLOWED_ORIGINS=https://mirestaurante.digidan.co

# Clave personalizada opcional para el usuario de soporte oculto digidanMasterAdmin (por defecto 3264 si se deja vacía)
MASTER_ADMIN_PASSWORD=

# Master Key opcional para emergencias (mínimo 32 caracteres)
MASTER_KEY=

# Uploads y Almacenamiento
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
# Límite máximo de almacenamiento de imágenes en megabytes (ej. 30 o 50)
MAX_IMAGE_STORAGE_MB=30
# Límite máximo de registros del sistema para la barra de capacidad (ej. 15000)
MAX_RECORDS_LIMIT=15000
