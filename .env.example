# ============================================================
# DigiRest v2 — Variables de Entorno (Dokploy / VPS)
# ============================================================

# Entorno y Puerto
NODE_ENV=production
PORT=3000

# Seguridad JWT
JWT_SECRET=super_secreto_jwt_generar_cadena_aleatoria_larga_aqui

# Integración SaaS Manager Central (panel.digidan.co)
# URL del panel central y API Key / Token del inquilino (Tenant Key)
SAAS_MANAGER_URL=https://panel.digidan.co
SAAS_TENANT_KEY=tu_token_secreto_generado_en_panel

# CORS (en producción puedes usar tu dominio o * para permitir el subdominio)
ALLOWED_ORIGINS=*

# Master Key opcional para emergencias (permite entrar como 'master' si se define)
MASTER_KEY=

# Uploads y Almacenamiento
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
# Límite máximo de almacenamiento de imágenes en megabytes (ej. 30 o 50)
MAX_IMAGE_STORAGE_MB=30
# Límite máximo de registros del sistema para la barra de capacidad (ej. 15000)
MAX_RECORDS_LIMIT=15000
