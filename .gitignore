# ============================================================
# DigiRest v2 — .gitignore
# ============================================================

# Dependencies
node_modules/
frontend/node_modules/
server/node_modules/

# Environment variables (NEVER commit production secrets)
.env
.env.local
server/.env
frontend/.env

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# SQLite temporary journal files (the clean template pos.sqlite is committed)
server/data/*.sqlite-wal
server/data/*.sqlite-shm
server/data/*.sqlite-journal
server/data/*.db-wal
server/data/*.db-shm

# User uploads (only .gitkeep is tracked)
server/uploads/*
!server/uploads/.gitkeep

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
